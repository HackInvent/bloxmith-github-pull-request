{
  "kind": "github_pull_request",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "PR creation",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "issue",
        "title": "Issue",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many",
        "required": true,
        "execution_requirement": "required_for_execution"
      },
      {
        "id": 2,
        "name": "branche",
        "title": "Branche",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many",
        "required": true,
        "execution_requirement": "required_for_execution"
      },
      {
        "id": 3,
        "name": "rapport_dev",
        "title": "Rapport dev",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "rapport_pr",
        "title": "Rapport PR",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "summary",
        "title": "Summary",
        "emits": [
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "api_base_url": "https://api.github.com",
    "token": "",
    "repo": "",
    "base_branch": "main",
    "draft": true,
    "dry_run": true,
    "timeout_sec": 30,
    "title_template": "",
    "body_template": ""
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties_mount.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      }
    ]
  }
}
